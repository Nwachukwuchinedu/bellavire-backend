# ========================================
# Bellavire API Environment Variables
# ========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=

# JWT Configuration
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth Configuration 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application URLs
BACKEND_BASE_URL=
FRONTEND_URL=

# Sendgrid Config
SENDGRID_API_KEY=
SENDGRID_SENDER=
# ========================================
# Instructions:
# 1. Copy this file to .env
# 2. Update the values according to your setup
# 3. Never commit .env to version control
# ======================================== 