# ========================================
# Bellavire API Environment Variables
# ========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=

# JWT Configuration
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth Configuration 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google redirect for linking google
GOOGLE_REDIRECT_URI=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Instagram OAuth
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=

# Application URLs
BACKEND_BASE_URL=
FRONTEND_URL=

# Sendgrid Config
SENDGRID_API_KEY=
SENDGRID_SENDER=

# Gemini Configuration
 GEMINI_API_KEY=

#Paystack Configuration
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ========================================
# Instructions:
# 1. Copy this file to .env
# 2. Update the values according to your setup
# 3. Never commit .env to version control
# ======================================== 